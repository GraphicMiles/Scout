{
  "name": "scout",
  "version": "0.1.0",
  "description": "Lightweight browser automation runtime with an authenticated HTTP API",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "sdk/index.js",
  "exports": { ".": "./sdk/index.js" },
  "types": "sdk/index.d.ts",
  "scripts": {
    "start": "node src/index.js",
    "dev": "SCOUT_DEV_MODE=1 node src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "bench": "node bench/bench.js"
  }
}

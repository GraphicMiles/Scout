{
  "name": "@graphicmiles/scout",
  "version": "0.1.1",
  "description": "Lightweight headless browser runtime: fetch, DOM, sandboxed page JavaScript, forms, extraction. One small Rust binary, no Chromium.",
  "type": "module",
  "license": "MIT",
  "main": "scout/sdk/index.js",
  "exports": {
    ".": "./scout/sdk/index.js",
    "./sdk": "./scout/sdk/index.js",
    "./driver": "./driver/index.js"
  },
  "files": [
    "scout/sdk/",
    "driver/",
    "postinstall.mjs",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node postinstall.mjs",
    "test": "node scout/sdk/test-sdk.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GraphicMiles/Scout.git"
  },
  "keywords": [
    "scraping",
    "headless",
    "browser",
    "automation",
    "extract"
  ],
  "publishConfig": {
    "access": "public"
  }
}
